{
  "project": {
    "name": "AI Placement OS",
    "working_title": "CareerPilot AI",
    "version": "1.0",
    "type": "AI-powered career preparation and placement SaaS",
    "goal": "Build a production-oriented platform that creates a personalized placement preparation system for students using resume intelligence, job-description matching, adaptive learning, AI interviews, coding/SQL practice, project-viva preparation, application tracking, and progress analytics.",
    "primary_users": [
      "College students preparing for placements",
      "Students targeting internships and entry-level jobs",
      "Students preparing for Data Science, Data Analytics, Software Engineering, AI/ML, Business Analyst and related roles"
    ],
    "secondary_users": [
      "College placement cells",
      "Training and placement departments",
      "Career coaches"
    ],
    "business_model": "Freemium B2C initially, followed by paid student subscriptions and B2B college plans.",
    "core_principle": "The platform should behave like a personalized placement operating system, not a generic resume checker or chatbot."
  },
  "product_vision": {
    "one_line": "Upload your resume and target JD, and the platform builds and continuously adapts your placement preparation plan.",
    "core_loop": [
      "Understand the student's profile",
      "Understand the target job",
      "Measure skill and evidence gaps",
      "Create a personalized preparation plan",
      "Test the student",
      "Identify weaknesses",
      "Adapt the plan",
      "Simulate interviews",
      "Track applications and outcomes",
      "Use performance history to personalize future preparation"
    ],
    "differentiators": [
      "Resume-aware interviews",
      "JD-specific preparation",
      "Project-defense/viva preparation",
      "Persistent weakness and interview memory",
      "Adaptive difficulty",
      "SQL/coding evaluation",
      "Personalized learning roadmap",
      "Application and interview tracking",
      "Evidence-based skill matching instead of a single meaningless ATS score"
    ]
  },
  "target_roles": [
    "Data Scientist",
    "Data Analyst",
    "ML Engineer",
    "AI Engineer",
    "Software Engineer",
    "Business Analyst",
    "Product Analyst",
    "Data Engineer"
  ],
  "user_journey": {
    "new_user": [
      "Sign up",
      "Complete profile",
      "Upload resume",
      "System extracts structured profile",
      "Select target role",
      "Upload or paste target JD",
      "System parses JD",
      "Resume-JD matching is performed",
      "Skill gaps and evidence gaps are generated",
      "Personalized roadmap is created",
      "Student starts daily preparation",
      "Student takes quizzes, coding/SQL tests and mock interviews",
      "System updates weakness profile",
      "Roadmap adapts",
      "Student tracks applications and interview outcomes"
    ],
    "returning_user": [
      "Open dashboard",
      "See today's recommended tasks",
      "Continue unfinished preparation",
      "Take recommended practice",
      "Receive feedback",
      "Review weak concepts",
      "Start company/JD-specific mock interview",
      "Update application status"
    ]
  },
