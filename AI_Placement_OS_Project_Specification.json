  "ai_ml_system": {
    "architecture": {
      "resume_parser": "LLM + deterministic document parsing + schema validation",
      "jd_parser": "LLM + skill taxonomy + schema validation",
      "matching": "Rule-based matching + embeddings + optional learning-to-rank model",
      "question_generation": "LLM + retrieval + difficulty metadata",
      "answer_evaluation": "LLM rubric + deterministic checks where possible",
      "personalization": "Rule engine initially; ML ranking/recommendation later",
      "readiness_model": "Optional supervised model after sufficient historical data exists",
      "adaptive_difficulty": "Performance-based rule engine initially; contextual bandit/recommendation model later"
    },
    "model_development_principle": "Do not train ML models just to claim ML. Use classical ML where labeled data and a measurable prediction problem exist. Use LLMs for language generation/extraction and deterministic systems for validation.",
    "future_models": [
      {
        "name": "Question Difficulty Predictor",
