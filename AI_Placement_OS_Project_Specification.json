      "outputs": [
        "Structured resume JSON",
        "Skill list",
        "Skill evidence",
        "Project list",
        "Experience list",
        "Education list",
        "Certification list",
        "Resume embeddings",
        "Potential inconsistencies",
        "Missing or weak evidence indicators"
